 │ 1 │ /// Doc comment.                                                       │ 
 │ 2 │ fn main() {                                                            │ 
 │ 3 │     let greeting = "hello";                                            │ 
 │ 4 │     println!("{greeting}, world");                                     │ 
 │ 5 │ }                                                                      │ 
